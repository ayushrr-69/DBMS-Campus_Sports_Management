{
  "name": "campus-sports-tournament",
  "version": "1.0.0",
  "private": true,
  "description": "Role-based Express web app for the Campus Sports Tournament DBMS project",
  "main": "app/server.js",
  "scripts": {
    "start": "node app/server.js",
    "check": "node --check app/server.js",
    "seed:users": "node app/seed-users.js",
    "test": "node --test",
    "export:pdf": "node scripts/export-pdf.js",
    "export:queries-pdf": "node scripts/export-pdf.js docs/DBMS_QUERIES_AND_AGGREGATES.md",
    "export:all-pdfs": "node scripts/export-pdf.js && node scripts/export-pdf.js docs/DBMS_QUERIES_AND_AGGREGATES.md"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "mysql2": "^3.12.0",
    "supertest": "^7.0.0"
  }
}
